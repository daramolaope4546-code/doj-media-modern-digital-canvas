# Web3Forms access key for the contact form.
# Get a free key at https://web3forms.com/ then add it here for local development.
# For production (Vercel): add the same key in Vercel Project Settings -> Environment Variables
# as VITE_WEB3FORMS_ACCESS_KEY (must be set before building).
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here
