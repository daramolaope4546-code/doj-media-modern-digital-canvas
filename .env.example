# Web3Forms access key for the contact form.
# Get a free key at https://web3forms.com/ then add it here for local development.
# For production (Vercel/Lovable): add the same key in your host's environment variables
# as VITE_WEB3FORMS_ACCESS_KEY (must be set before building).
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# ── Supabase (Client Reviews / Admin Panel) ──────────────────────────
# Create a free Supabase project at https://supabase.com
# 1. Go to Project Settings > API and copy the Project URL and anon public key.
# 2. Run the SQL schema below in the SQL Editor to create the reviews table.
# 3. Go to Authentication > Providers and enable Email (it is on by default).
# 4. Create an admin user via Authentication > Users > Add user (email + password).
# 5. Paste the values below and restart the dev server.
#
# For production (Vercel/Lovable): add these as environment variables in your host's dashboard.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
