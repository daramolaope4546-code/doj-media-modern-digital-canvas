# Web3Forms access key for the contact form.
# Get a free key at https://web3forms.com/ then add it here for local development.
# For production (Vercel): add the same key in Vercel Project Settings -> Environment Variables
# as VITE_WEB3FORMS_ACCESS_KEY (must be set before building).
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Passcode gate for the private review-moderation page at /reviews-admin.
# Store the SHA-256 hash of your passcode (never the passcode itself).
# The raw passcode is never shipped to the browser.
# Generate it with:
#   node -e "crypto.createHash('sha256').update('YOUR_PASSCODE').digest('hex')"
# (Set the same value in your host's build-time environment variables.)
VITE_REVIEWS_ADMIN_HASH=your_sha256_hex_here
